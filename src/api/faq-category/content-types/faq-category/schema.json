{
  "kind": "collectionType",
  "collectionName": "faq_categories",
  "info": {
    "singularName": "faq-category",
    "pluralName": "faq-categories",
    "displayName": "Categorias (FAQ)",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-item.faq-item",
      "mappedBy": "category"
    }
  }
}
